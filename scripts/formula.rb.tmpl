# Homebrew formula for apple-health-mcp.
#
# Generated by scripts/update-formula.sh from scripts/formula.rb.tmpl whenever a
# release is tagged. Edit the template, not the generated formula.
class AppleHealthMcp < Formula
  desc "MCP server for querying Apple Health export data"
  homepage "https://github.com/vpetersson/apple-health-mcp-server"
  version "@@VERSION@@"
  license "MIT"

  on_macos do
    on_arm do
      url "@@BASE_URL@@/apple-health-mcp-@@TAG@@-aarch64-apple-darwin"
      sha256 "@@SHA256_AARCH64_APPLE_DARWIN@@"
    end

    on_intel do
      url "@@BASE_URL@@/apple-health-mcp-@@TAG@@-x86_64-apple-darwin"
      sha256 "@@SHA256_X86_64_APPLE_DARWIN@@"
    end
  end

  on_linux do
    on_intel do
      url "@@BASE_URL@@/apple-health-mcp-@@TAG@@-x86_64-unknown-linux-gnu"
      sha256 "@@SHA256_X86_64_UNKNOWN_LINUX_GNU@@"
    end
  end

  def install
    # The release assets are bare binaries, so Homebrew stages the single
    # downloaded file under its release name rather than unpacking an archive.
    bin.install Dir["apple-health-mcp-*"].fetch(0) => "apple-health-mcp"
  end

  def caveats
    <<~EOS
      The database defaults to ~/.config/apple-health-mcp/health.duckdb. Import
      an Apple Health export before starting the server:

        apple-health-mcp import --export-dir /path/to/apple_health_export
        apple-health-mcp serve
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/apple-health-mcp --version")

    (testpath/"export.xml").write <<~XML
      <?xml version="1.0" encoding="UTF-8"?>
      <HealthData locale="en_US">
       <Record type="HKQuantityTypeIdentifierStepCount" sourceName="iPhone" unit="count" value="1500" startDate="2024-01-01 09:00:00 +0000" endDate="2024-01-01 09:30:00 +0000"/>
      </HealthData>
    XML

    system bin/"apple-health-mcp", "import", "--export-dir", testpath, "--db", testpath/"health.duckdb"
    assert_path_exists testpath/"health.duckdb"
  end
end
